# BetMexico — variables de entorno (PRODUCCIÓN en KVM4)
# Copiar este archivo a `.env` en /docker/betmexico/ y rellenar
# NO commitear `.env` real

# Telegram
BMX_BOT_TOKEN=

# Captcha solvers
BMX_CAPMONSTER_KEY=
CAPMONSTER_KEY=             # alias usado por dashboard (mismo valor que BMX_CAPMONSTER_KEY)
BMX_RECAPTCHA_SITEKEY=
BMX_CAPSOLVER_KEY=          # legacy / fallback

# BD (path dentro del container)
BETMEX_DB=/data/betmexico_accounts.db

# Dashboard web
BMX_WEB_PORT=8080
BMX_MASTER=                 # bypass auth para superadmin

# Servicios externos
WSAI_API_KEY=               # WebScraping.ai — monitor sidebar
KIMI_API_KEY=               # Moonshot Kimi K2.5 (opcional)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
